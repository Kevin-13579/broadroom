# ==========================================================
# Boardroom Environment Configuration (.env.example)
# Rename this file to .env on your AWS EC2 instance.
# DO NOT COMMIT THE ACTUAL .env FILE TO GITHUB!
# ==========================================================

# Database Configuration (AWS RDS MySQL Endpoint)
# Example: jdbc:mysql://boardroom-mysql.c3xxxxxx.us-east-1.rds.amazonaws.com:3306/boardroom_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_URL=jdbc:mysql://<RDS_ENDPOINT>:3306/boardroom_db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=YourSecureRdsPassword123!

# AI LLM API Key (Google AI Studio Gemini Key)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Security JWT Secret (64+ characters random hex string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# CORS Allowed Origins (* allows all, or specify your CloudFront/Domain URL)
APP_CORS_ALLOWED_ORIGINS=*

# Optional frontend API URL (empty defaults to relative path /api via Nginx proxy)
VITE_API_URL=
